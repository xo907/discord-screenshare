# Runs the bot on boot and restarts it if it crashes.
# Install (edit User/WorkingDirectory first if yours differ):
#   sudo cp discord-screenshare.service /etc/systemd/system/
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now discord-screenshare
# Logs:  journalctl -u discord-screenshare -f

[Unit]
Description=Discord screenshare streamer
After=network-online.target
Wants=network-online.target

[Service]
User=pi
WorkingDirectory=/home/pi/discord-screenshare
ExecStart=/usr/bin/node src/bot.js
Restart=on-failure
RestartSec=10
# Give ffmpeg priority over background tasks so playback never stutters.
Nice=-5

[Install]
WantedBy=multi-user.target
